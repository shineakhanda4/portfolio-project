# Public canonical origin used in metadata, sitemap, and RSS.
# Set this in Cloudflare Pages for the custom domain.
VITE_SITE_URL=https://shineakhanda.dev

# Used only by scripts/prerender.mjs at build time.
SITE_URL=https://shineakhanda.dev

# Contact form delivery (Hono API on Cloudflare at /api/contact).
# Create a Resend API key and verify the shineakhanda.dev sending domain first.
RESEND_API_KEY=
CONTACT_TO_EMAIL=me@shineakhanda.dev
# Must be a sender address verified with your email provider.
CONTACT_FROM_EMAIL=Shine Akhanda Website <website@shineakhanda.dev>
